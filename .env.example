# Safe default: local paper trading. Never commit a real .env file.
TRADING_MODE=paper
BINANCE_ENVIRONMENT=testnet
BINANCE_API_KEY=
BINANCE_API_SECRET=
TRADING_SYMBOL=BTCUSDT
TRADING_INTERVAL=1m
LOOP_INTERVAL_SECONDS=20
FAST_SMA_PERIOD=7
SLOW_SMA_PERIOD=25
ORDER_QUOTE_AMOUNT=10
MAX_POSITION_QUOTE=25
MAX_DAILY_LOSS_QUOTE=2
MAX_TRADES_PER_DAY=6
TRADE_COOLDOWN_SECONDS=300
PAPER_STARTING_QUOTE=1000
PAPER_RESEARCH_GATE_ENABLED=true
PAPER_AUTO_DEPLOY_EXPERIMENTAL=true
PAPER_EXPERIMENTAL_EXECUTION_ENABLED=true
SIMULATED_SPREAD_BPS=1
SIMULATED_SLIPPAGE_BPS=5
LOCAL_TIMEZONE=America/Costa_Rica
STOP_LOSS_PCT=1.5
TAKE_PROFIT_PCT=3.0
TRAILING_STOP_PCT=1.2
AUTO_TRAINING_ENABLED=true
TRAINING_INTERVAL_HOURS=24
TRAINING_SOURCE_INTERVAL=15m
TRAINING_CANDLES=35040
MINIMUM_VALIDATION_TRADES=8
SHADOW_TRADING_ENABLED=true
SHADOW_STARTING_QUOTE=1000
SHADOW_COHORT_MIN_AGE_HOURS=168
SHADOW_MIN_COMPLETED_TRADES=30
SHADOW_MIN_PROFIT_FACTOR=1.10
# Reserved for a future certified live release. Real trading is intentionally disabled today.
ENABLE_LIVE_TRADING=false
# Set a long random value when binding beyond 127.0.0.1.
DASHBOARD_TOKEN=
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
